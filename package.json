{
  "name": "uae-einvoice-mcp",
  "version": "0.2.2",
  "description": "MCP server for UAE e-invoicing / PINT AE: TRN/TIN checks, 51-field checklist, scope, UBL XML, official Schematron",
  "mcpName": "io.github.mirzaabubakr/uae-einvoice-mcp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "uae-einvoice-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirzaabubakr/uae-einvoice-mcp.git"
  },
  "homepage": "https://github.com/mirzaabubakr/uae-einvoice-mcp",
  "bugs": {
    "url": "https://github.com/mirzaabubakr/uae-einvoice-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "selfcheck": "tsx src/selfcheck.ts",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "uae",
    "e-invoicing",
    "pint-ae",
    "peppol",
    "trn",
    "fta"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "saxon-js": "^2.7.0",
    "xslt3": "^2.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
