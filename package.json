{
  "name": "uae-einvoice-mcp",
  "version": "0.1.0",
  "description": "MCP server for UAE e-invoicing / PINT AE compliance checks, TRN-TIN validation, and mandate requirements",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "uae-einvoice-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "selfcheck": "tsx src/selfcheck.ts",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "uae",
    "e-invoicing",
    "pint-ae",
    "peppol",
    "trn",
    "fta"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
